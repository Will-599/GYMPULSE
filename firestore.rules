rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================================
    // 1. FUNÇÕES DE BASE (SEGURANÇA CENTRALIZADA)
    // =============================================================

    // Verifica se há um usuário autenticado no Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Identifica se o usuário logado é o administrador master do sistema
    // Isso ignora qualquer permissão de tenant e dá acesso total.
    function isMaster() {
      return isAuthenticated() && 
             request.auth.token.email.lower() == "admin@admin.com";
    }

    // Obtém o tenantId do documento do usuário logado
    function getMyTenantId() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? get(userPath).data.tenantId : "NO_TENANT";
    }

    // Obtém o cargo do usuário logado
    function getRole() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? get(userPath).data.role : "GUEST";
    }

    // Verifica se o usuário pertence à academia (tenant) correta
    function belongsToTenant(docData) {
      return isMaster() || (
        isAuthenticated() && 
        docData.tenantId == getMyTenantId()
      );
    }

    // Papéis de acesso
    function isOwner() { return isMaster() || getRole() == 'OWNER'; }
    function isAdmin() { return isMaster() || getRole() in ['OWNER', 'ADMIN']; }
    function isInstructor() { return isMaster() || getRole() in ['OWNER', 'ADMIN', 'INSTRUCTOR']; }
    function isStudent() { return isMaster() || getRole() == 'STUDENT'; }

    // =============================================================
    // 2. REGRAS POR COLEÇÃO
    // =============================================================

    // COLEÇÃO: tenants (Academias)
    match /tenants/{tenantId} {
      // O Master pode listar todas. Gestores veem apenas a sua.
      allow list: if isMaster();
      allow get:  if isMaster() || (isAuthenticated() && getMyTenantId() == tenantId);
      
      // Criar academia é livre para o onboarding inicial ou para o Master
      allow create: if isAuthenticated();
      
      // Apenas Admins da própria academia ou Master podem editar
      allow update: if isMaster() || (isAdmin() && getMyTenantId() == tenantId);
      allow delete: if false; // Soft-delete gerenciado por flag
    }

    // COLEÇÃO: users (Perfis de Sistema)
    match /users/{userId} {
      allow read:   if isMaster() || request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isMaster() || (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'tenantId']));
      allow delete: if false;
    }

    // COLEÇÃO: students (Alunos)
    match /students/{studentId} {
      allow read: if isInstructor() && belongsToTenant(resource.data) || 
                  (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isInstructor() && belongsToTenant(request.resource.data || resource.data);
    }

    // COLEÇÃO: checkins
    match /checkins/{id} {
      allow read:  if isInstructor() && belongsToTenant(resource.data);
      allow write: if isInstructor() && belongsToTenant(request.resource.data || resource.data);
    }

    // COLEÇÃO: evolution_records (Acompanhamento)
    match /evolution_records/{id} {
      allow read: if isInstructor() && belongsToTenant(resource.data) || 
                  (isAuthenticated() && exists(/databases/$(database)/documents/students/$(resource.data.studentId)) && 
                   get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.userId == request.auth.uid);
      allow write: if isInstructor() && belongsToTenant(request.resource.data || resource.data);
    }

    // COLEÇÃO: trainingPlans (Planos Ativos dos Alunos)
    match /trainingPlans/{id} {
      allow read:  if belongsToTenant(resource.data);
      allow write: if isInstructor() && belongsToTenant(request.resource.data || resource.data);
    }

    // COLEÇÃO: workoutTemplates (Biblioteca de Treinos)
    match /workoutTemplates/{id} {
      allow read:  if belongsToTenant(resource.data);
      allow write: if isInstructor() && belongsToTenant(request.resource.data || resource.data);
    }

    // COLEÇÃO: payments (Financeiro)
    match /payments/{id} {
      allow read: if isAdmin() && belongsToTenant(resource.data) || 
                  (isAuthenticated() && exists(/databases/$(database)/documents/students/$(resource.data.studentId)) && 
                   get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.userId == request.auth.uid);
      allow write: if isAdmin() && belongsToTenant(request.resource.data || resource.data);
    }

    // COLEÇÃO: diet_plans (Nutrição)
    match /diet_plans/{id} {
      allow read: if isInstructor() && belongsToTenant(resource.data) || 
                   (isAuthenticated() && exists(/databases/$(database)/documents/students/$(resource.data.studentId)) && 
                    get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.userId == request.auth.uid);
      allow write: if isInstructor() && belongsToTenant(request.resource.data || resource.data);
    }

    // COLEÇÃO: plans (Planos de Preço da Academia)
    match /plans/{id} {
      allow read:  if belongsToTenant(resource.data);
      allow write: if isAdmin() && belongsToTenant(request.resource.data || resource.data);
    }
  }
}
