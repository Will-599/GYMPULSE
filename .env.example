# =========================================================================
# GYMPULSE ENVIRONMENT CONFIGURATION
# =========================================================================

# --- PUBLIC / FRONTEND CONFIGURATION ---
# These variables ARE EXPOSED to the browser. 
# Only put values here that are safe for the public to see.
# All variables prefixed with VITE_ will be bundled into the frontend.

# Firebase Configuration (Required for the app to function)
VITE_FIREBASE_API_KEY="YOUR_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# --- PRIVATE / BACKEND CONFIGURATION ---
# DO NOT include these in vite.config.ts 'define' block.
# These should ONLY be used in server-side code or cloud functions.

# Gemini AI Configuration (Private Key - DO NOT EXPOSE TO FRONTEND)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Application URL
APP_URL="YOUR_APP_URL"

